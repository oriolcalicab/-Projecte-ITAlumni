{
  "compilerOptions": {
    /* 🚀 RUTES DE LES CARPETES: Descomentades i configurades */
    "rootDir": "./src/ts",                     // On escrius els teus arxius .ts
    "outDir": "./src/js",                     // On es crearan els arxius .js de sortida

    /* 🌐 CONFIGURACIÓ PER A NAVEGADOR (FRONT-END) */
    "module": "ES6",                           // Canviat de nodenext a ES6 perquè el navegador ho entengui directament
    "target": "ES6",                           // JavaScript modern estàndard
    "types": [],

    /* Altres opcions que ja tenies de sortida */
    "sourceMap": true,
    "declaration": false,                      // Canviat a false perquè no et crei arxius .d.ts molestos a la carpeta js
    "declarationMap": false,

    /* Validacions de tipus estrictes (les que tenies) */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  /* 📂 INCLOURE CARPETES: Diu a TypeScript on ha de mirar */
  "include": ["src/ts/**/*"]
}